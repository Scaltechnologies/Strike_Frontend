# Shared default backend URL for local development. Expo inlines EXPO_PUBLIC_*
# vars into the JS bundle at build time (see axiosInstance.ts) — no extra
# package needed. Override per-machine in a gitignored .env.local instead of
# editing this file, so everyone's personal LAN IP doesn't clash in git.
EXPO_PUBLIC_API_URL=http://192.168.88.12:8080
