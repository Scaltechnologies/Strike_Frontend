{
  "expo": {
    "name": "Strike",
    "slug": "Stike",
    "version": "1.0.0",
    "scheme": "strike-frontend",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FEF0E6"
      },
      "package": "com.strike.frontend",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "bundleIdentifier": "com.strike.frontend"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Strike needs your location to set your store on the map."
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Strike needs access to your photos so you can set a banner image for your store."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#CC2200",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Strike needs your camera to scan a customer's Pay-at-Store QR code."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7364ce84-408c-47ae-823d-bff4da22b602"
      }
    },
    "owner": "nikhilvarma"
  }
}
