{
  "expo": {
    "name": "Strike Vendor",
    "slug": "scalatechnologies",
    "version": "1.0.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/208fbff4-8198-43ba-b48d-f85c9c3f5353",
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "fallbackToCacheTimeout": 0
    },
    "scheme": "strike-frontend",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.strike.frontend",
      "versionCode": 5,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.strike.frontend"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Strike needs your location to set your store on the map."
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Strike needs access to your photos so you can set a banner image for your store.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#CC2200",
          "sounds": ["./assets/sounds/notify.wav", "./assets/sounds/vendor_alert_siren.wav"]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Strike needs your camera to scan a customer's Pay-at-Store QR code.",
          "recordAudioAndroid": false
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging"
    ],
    "extra": {
      "eas": {
        "projectId": "208fbff4-8198-43ba-b48d-f85c9c3f5353"
      },
      "router": {}
    },
    "owner": "scalatechnologiess-team"
  }
}
